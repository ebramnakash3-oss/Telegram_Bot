# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Drive: set the parent folder where property folders will be created
GDRIVE_PARENT_FOLDER_ID=your_parent_folder_id_here

# Authentication option 1 (recommended): Service Account
# Path to your service account JSON key file. Share the parent folder with the
# service account email so it can create folders/files inside it.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Authentication option 2: OAuth client (installed app)
# If using OAuth, provide your client secrets JSON and a token file path.
# GOOGLE_OAUTH_CLIENT_SECRETS=credentials.json
# GOOGLE_TOKEN_FILE=token.json